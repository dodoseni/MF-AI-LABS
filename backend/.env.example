# Copy to `.env` (already git-ignored) and set a real value locally/in the
# runtime environment. Never commit an actual connection string.
#
# Prisma-format connection string for the Azure SQL datasource configured in
# prisma/schema.prisma. See backend/README.md ("Database (Prisma + Azure SQL)")
# for the expected shape, where the value comes from, and open questions about
# how it reaches the runtime environment.
#
# Leave unset to have the server resolve it automatically from Azure Key
# Vault at startup (see AZURE_KEY_VAULT_URL below); set it here only for
# local development against a reachable SQL Server.
DATABASE_URL=

# URI of the Azure Key Vault holding the `SqlConnectionString2` secret
# (Prisma-format connection string). Used by src/config/loadDatabaseUrl.js
# via DefaultAzureCredential — no vault name/URL is hardcoded in application
# code. Example shape: https://<vault-name>.vault.azure.net/
AZURE_KEY_VAULT_URL=
